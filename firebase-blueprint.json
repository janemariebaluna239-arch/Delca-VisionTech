      "required": ["id", "fullName", "company", "email"]
    },
    "events": {
      "title": "DELCAEvent",
      "description": "Executive summits and corporate events.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "eventName": { "type": "string" },
        "targetIndustry": { "type": "string" },
        "targetRole": { "type": "string" },
